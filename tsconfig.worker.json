{
  // The Worker compiles against Cloudflare's globals rather than Bun's, and one
  // `types` array cannot be both — so it gets its own pass. `bun run typecheck`
  // covers everything else; this covers the file that only runs in production.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["@cloudflare/workers-types"],
    "lib": ["ES2022"]
  },
  // Only the entry point. TypeScript follows its imports into `server/market.ts`
  // and `shared/`, which is exactly the set the Worker actually ships — naming
  // `server/` would drag in `server/main.ts`, which is a Bun program.
  "include": ["worker"]
}
