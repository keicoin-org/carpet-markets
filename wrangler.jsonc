{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "keicoin-example-carpet-markets",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-01",
  // bananojs reaches for a couple of Node built-ins for key derivation.
  "compatibility_flags": ["nodejs_compat"],

  // The client, built by `bun run build:site` into dist/examples/carpet-markets/
  // so the asset paths match the URLs they are served at.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },

  // Which chain the deployed copy runs on, stated rather than defaulted.
  //
  // `mock` keeps the whole ledger inside the Durable Object. A versioned event
  // log rebuilds the same no-value demo after eviction; deleting the object's
  // storage is the explicit reset. `testnet` points the
  // registry at https://testnet.keicoin.org/rpc and turns /rpc into a
  // pass-through, which NETWORK.md shows working end to end.
  //
  // Flipping it is one word here and an operational decision that is not this
  // repository's to make: the public node is one best-effort box with no uptime
  // promise (SPEC §15), and every open tab polls it every two seconds. So it
  // ships as `mock` until somebody who owns that box says otherwise.
  //
  // `mainnet` is refused by the Worker on boot. It is not a value to try.
  "vars": {
    "CARPET_NETWORK": "mock",
    // Rollout phase 1. Deploy the checkpoint-aware binary once in `compat`,
    // verify it, and make that version the rollback floor before a later config
    // deployment changes this to `compact`. See NETWORK.md.
    "CARPET_LOG_MODE": "compat"
  },

  // The chain and the market. One object, one name, so everybody trades against
  // the same book.
  "durable_objects": {
    "bindings": [{ "name": "FLOOR", "class_name": "Floor" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Floor"] }],

  // More specific than keicoin-site's route, so this Worker owns the demo and
  // the site owns everything else (SPEC §10.4).
  "routes": [{ "pattern": "keicoin.org/examples/carpet-markets*", "zone_name": "keicoin.org" }],

  "observability": { "enabled": true }
}
