{
  "name": "carpet-markets",
  "version": "0.1.0",
  "private": true,
  "description": "A coin launchpad on Kei, with a real peer-to-peer order book, where whether a coin can be dumped on you is a transfer policy the chain enforces.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keicoin-org/carpet-markets.git"
  },
  "scripts": {
    "dev": "bun run dev.ts",
    "dev:api": "bun run server/main.ts",
    "probe:testnet": "bun run scripts/testnet-probe.ts",
    "seed": "bun run scripts/seed.ts",
    "walk": "bun run scripts/walk.ts",
    "build": "bun run build.ts",
    "build:site": "bun run build.ts",
    "preview": "bun run build.ts && wrangler dev",
    "deploy": "bun run build.ts && wrangler deploy",
    "check": "bun run typecheck && bun run typecheck:worker && bun run typecheck:worker-test && bun test && bun run test:workers",
    "typecheck": "tsc --noEmit",
    "typecheck:worker": "tsc --noEmit -p tsconfig.worker.json",
    "typecheck:worker-test": "tsc --noEmit -p tsconfig.worker-test.json",
    "test": "bun test",
    "test:workers": "vitest run --config vitest.worker.config.ts && vitest run --config vitest.mainnet.config.ts"
  },
  "dependencies": {
    "@keicoin/core": "^0.5.0",
    "kei-transaction": "^0.8.0",
    "next": "^16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.1",
    "@cloudflare/workers-types": "^5.20260801.1",
    "@happy-dom/global-registrator": "^20.11.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "happy-dom": "^20.11.1",
    "postcss": "^8.5.25",
    "puppeteer-core": "^25.5.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.0.0"
  }
}
