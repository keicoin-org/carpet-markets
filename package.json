{
  "name": "carpet-markets",
  "version": "0.1.0",
  "private": true,
  "description": "A coin launchpad on Kei, where the difference between a rug and a real one is a transfer policy the chain enforces.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keicoin-org/carpet-markets.git"
  },
  "scripts": {
    "dev": "bun run server/main.ts",
    "build": "bun build src/main.ts --outdir public/build --target browser --sourcemap=linked",
    "build:site": "bun run build.ts",
    "preview": "bun run build.ts && wrangler dev",
    "deploy": "bun run build.ts && wrangler deploy",
    "check": "bun run typecheck && bun run typecheck:worker && bun test",
    "typecheck": "tsc --noEmit",
    "typecheck:worker": "tsc --noEmit -p tsconfig.worker.json",
    "test": "bun test"
  },
  "dependencies": {
    "kei-transaction": "^0.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "@types/bun": "^1.3.14",
    "typescript": "^5.9.0",
    "wrangler": "^4.0.0"
  }
}
